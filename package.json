{
  "name": "dsh-session-telecom",
  "version": "1.3.3",
  "description": "跨目录 / 跨项目的 DSH 会话内置通话：任意两条会话直接收发消息、工具级唤醒、只读查看与用量 · Cross-directory session calling for DSH.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:client": "node client/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build:client && npm run check:package"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "cross-session",
    "cross-project",
    "workspace",
    "session-call",
    "inter-session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltmroberthk915/dsh-session-telecom.git"
  },
  "homepage": "https://github.com/ltmroberthk915/dsh-session-telecom#readme",
  "bugs": {
    "url": "https://github.com/ltmroberthk915/dsh-session-telecom/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
